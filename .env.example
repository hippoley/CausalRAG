# Hosted proposer credentials
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional local OpenAI-compatible proposer
LOCAL_LLM_URL=http://localhost:1234/v1
BRANCHPOINT_SMALL_MODEL=local-model

# Frontier proposer default shown by the Playable Probe
BRANCHPOINT_FRONTIER_MODEL=gpt-5.6-terra

# Optional retrieval configuration
BRANCHPOINT_EMBEDDING_MODEL=text-embedding-3-small
BRANCHPOINT_INDEX_PATH=
BRANCHPOINT_GRAPH_PATH=

# Playable Probe / API
BRANCHPOINT_API_HOST=0.0.0.0
BRANCHPOINT_API_PORT=8765

# External-model access control.
# Local development can leave auth disabled. Public deployments with paid
# provider credentials should require owner access and secure cookies.
BRANCHPOINT_REQUIRE_PROBE_AUTH=false
BRANCHPOINT_PROBE_ACCESS_TOKEN=
BRANCHPOINT_PROBE_COOKIE_SECURE=false

# Optional durable Playable Probe archive.
# When set, the latest session artifact survives process restarts.
# This is archival/recovery context, not automatic continuation of a live thread.
BRANCHPOINT_PROBE_SESSION_DB=
